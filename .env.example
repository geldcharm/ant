# Copy this file to `.env` and adjust for your environment.
# Vite only exposes variables that start with VITE_ to the client bundle.

# Public path the app is served from. Use "/" for root, "/myapp/" if hosted
# under a subdirectory (e.g. GitHub Pages project sites).
VITE_BASE_PATH=/

# Display name shown in the UI. Defaults to "PaveMaster" if unset.
VITE_APP_NAME=PaveMaster

# When you wire up Supabase, add:
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
